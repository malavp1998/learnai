# Copy this file to .env and fill in your keys:  cp .env.example .env

# Same Groq key used by the rest of the repo. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Jina AI embeddings API key. Free key: https://jina.ai/embeddings (click "Get API key")
JINA_API_KEY=

# Matches the credentials in docker-compose.yml — no need to change unless you edit that file too.
DATABASE_URL=postgresql://mindhold:mindhold@localhost:5432/mindhold
